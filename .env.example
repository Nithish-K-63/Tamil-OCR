# TamilOCRGOV — Root Environment Variables Template
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8443,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8443
DEVICE=cpu
CONFIDENCE_THRESHOLD=80.0

# MongoDB Atlas Configuration (Cloud Persistent Storage with SQLite Fallback)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.itpmyr3.mongodb.net/tamilocrgov?retryWrites=true&w=majority
MONGODB_DB_NAME=tamilocrgov
MONGODB_USER=<db_username>
MONGODB_PASSWORD=<db_password>
MONGODB_CLUSTER=cluster0.itpmyr3.mongodb.net

# Bodhan Indic-OCR Cloud API Configuration (Secure Backend Credentials)
BODHAN_API_KEY=your_bodhan_api_key_here
BODHAN_API_ENDPOINT=https://api.bodhan.ai/v1
BODHAN_MODEL=indic-ocr

# AI Assistant & Chatbot (Secure Backend Credentials)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
