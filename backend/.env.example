# TamilOCR Backend Environment Variables
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173,http://localhost:8443
DEVICE=cpu
HF_MODEL_REPO=dhruv10050/t3-7-indic-recognition
CONFIDENCE_THRESHOLD=80.0

# MongoDB Atlas Configuration
# Connection URI format: mongodb+srv://<db_user>:<db_password>@cluster0.itpmyr3.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://nithishk63741_db_user:<db_password>@cluster0.itpmyr3.mongodb.net/tamilocrgov?retryWrites=true&w=majority
MONGODB_DB_NAME=tamilocrgov
MONGODB_USER=nithishk63741_db_user
MONGODB_PASSWORD=<db_password>
MONGODB_CLUSTER=cluster0.itpmyr3.mongodb.net

# Bodhan Indic-OCR Cloud API Configuration (Secure Backend Credentials)
# API key is kept exclusively on the backend - never expose in frontend
BODHAN_API_KEY=your_bodhan_api_key_here
BODHAN_API_ENDPOINT=https://api.bodhan.ai/v1
BODHAN_MODEL=indic-ocr

# AI Assistant Backend Configuration (Secure - kept exclusively on backend)
# Google Gemini API Key: get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

