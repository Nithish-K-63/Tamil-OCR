# TamilOCR Backend Environment Variables
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173,http://localhost:8443
DEVICE=cpu
HF_MODEL_REPO=dhruv10050/t3-7-indic-recognition
CONFIDENCE_THRESHOLD=80.0

# MongoDB Atlas Configuration
# Connection URI format: mongodb+srv://<actual_username>:<URL_ENCODED_PASSWORD>@cluster0.itpmyr3.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<actual_username>:<URL_ENCODED_PASSWORD>@cluster0.itpmyr3.mongodb.net/tamil_ocr?retryWrites=true&w=majority
MONGODB_DB_NAME=tamil_ocr
MONGODB_USER=<actual_username>
MONGODB_PASSWORD=<actual_password>
MONGODB_CLUSTER=cluster0.itpmyr3.mongodb.net

